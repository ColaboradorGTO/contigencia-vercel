{
    "version": 2,
    "buildCommand": "npm ci && npm run build",
    "builds": [
      {
        "src": "dist/server.js",
        "use": "@vercel/node",
        "config": {
          "nodeVersion": "22.x"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "dist/server.js"
      }
    ],
    "env": {
      "NODE_ENV": "production"
    }
}
