{
    "version": 2,
    "buildCommand": "bash build.sh",
    "builds": [
      {
        "src": "src/server.js",
        "use": "@vercel/node",
        "config": {
          "nodeVersion": "22.x"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "src/server.js"
      }
    ]
}
